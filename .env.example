# =============================================================================
# MOSCOWLE IA — Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# NEVER commit .env with real credentials to version control.
# =============================================================================

# ─── Flask ────────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-random-secret-key

# ─── Database ─────────────────────────────────────────────────────────────────
# SQLite for development:
# SQLALCHEMY_DATABASE_URI=sqlite:///moscowle.db
#
# MySQL/MariaDB for production:
SQLALCHEMY_DATABASE_URI=mysql+pymysql://user:password@host/dbname
REPLICA_DATABASE_URL=

# ─── Email ────────────────────────────────────────────────────────────────────
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your@email.com
MAIL_PASSWORD=your-email-password
MAIL_DEFAULT_SENDER=your@email.com

# ─── Admin ────────────────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password

# ─── AI/LLM Providers ─────────────────────────────────────────────────────────
# Primary: GLM-5.2 via NVIDIA NIM (agentic, tool use, reasoning)
GLM_API_KEY=nvapi-your-glm-api-key
# Secondary: Groq (fast fallback)
GEMINI_API_KEY=your-gemini-api-key
GROQ_API_KEY=your-groq-api-key
LLM_PROVIDER=glm
OLLAMA_MODEL=llama3.1:8b
OLLAMA_HOST=http://host.docker.internal:11434

# ─── Session & HTTPS ──────────────────────────────────────────────────────────
SESSION_COOKIE_SECURE=False
REMEMBER_COOKIE_SECURE=False
FORCE_HTTPS=False
PREFERRED_URL_SCHEME=http
WTF_CSRF_ENABLED=True
SESSION_COOKIE_SAMESITE=Lax

# ─── OAuth ────────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
OAUTH_REDIRECT_URI=

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:4200 http://localhost
SOCKET_CORS_ORIGINS=http://localhost:4200 http://localhost

# ─── Security ─────────────────────────────────────────────────────────────────
APP_SECRET_KEY=change-me-app-secret
JWT_SECRET_KEY=change-me-jwt-secret
SENTRY_DSN=

# ─── Redis / Cache ────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CACHE_TYPE=redis
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ─── Alerting / CrisisMonitor ─────────────────────────────────────────────────
ALERT_SLACK_WEBHOOK_URL=
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
ALERT_EMAIL_TO=
ALERT_DB_CONN_THRESHOLD=50
ALERT_BRUTE_FORCE_THRESHOLD=20
ALERT_BRUTE_FORCE_WINDOW_MINUTES=15
CRISIS_CHECK_INTERVAL=300

# ─── Railway Infrastructure Monitoring ─────────────────────────────────────────
# Create an Account/Workspace token at https://railway.com/account/tokens
RAILWAY_API_TOKEN=
# OR a Project token (scoped to single env) from project settings → tokens
RAILWAY_PROJECT_TOKEN=
# Get environmentId from: railway status --json → environment.id
RAILWAY_ENVIRONMENT_ID=
# Optional: get serviceId from: railway status --json → service.id
RAILWAY_SERVICE_ID=

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATELIMIT_STORAGE_URL=redis://redis:6379/0

# ─── Docker-specific ──────────────────────────────────────────────────────────
RUN_MIGRATIONS=true
DOCKER_ENV=true
