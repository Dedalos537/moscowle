# ============================================================
# Moscowle IA — Environment Variables
# Copiar a .env y llenar valores reales
# ============================================================

# --- Flask ---
FLASK_ENV=production
APP_SECRET_KEY=cambiar_por_clave_aleatoria_larga_64_caracteres
SECRET_KEY=${APP_SECRET_KEY}

# --- Base de Datos ---
SQLALCHEMY_DATABASE_URI=mysql+pymysql://usuario:contraseña@localhost/nombre_bd

# --- CSRF ---
WTF_CSRF_ENABLED=True
WTF_CSRF_TIME_LIMIT=3600
WTF_CSRF_SSL_STRICT=True

# --- Sesión ---
SESSION_COOKIE_SECURE=True
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
PERMANENT_SESSION_LIFETIME=86400

# --- Sentry ---
SENTRY_DSN=
SENTRY_SEND_PII=False
SENTRY_TRACES_SAMPLE_RATE=0.1

# --- APIs de IA ---
GEMINI_API_KEY=tu_key_de_gemini
GROQ_API_KEY=tu_key_de_groq

# --- Mail (Gmail SMTP) ---
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=tu-email@gmail.com
MAIL_PASSWORD=tu-app-password
MAIL_DEFAULT_SENDER=noreply@centrojuanpabloii.com

# --- Redis (para caché y rate limiting) ---
REDIS_URL=redis://localhost:6379/0

# --- CORS ---
CORS_ORIGINS=http://localhost:4200,https://moscowle.centrojuanpabloii.com
