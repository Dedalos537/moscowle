# Twilio SMS/WhatsApp Configuration (OPTIONAL)
# Leave empty to disable SMS/WhatsApp services

# Twilio Account SID (from https://www.twilio.com/console)
TWILIO_ACCOUNT_SID=your_account_sid_here

# Twilio Auth Token (from https://www.twilio.com/console)
TWILIO_AUTH_TOKEN=your_auth_token_here

# Twilio Phone Number for SMS (your verified Twilio number)
# Example: +15551234567
TWILIO_PHONE_NUMBER=+your_twilio_sms_number

# Twilio WhatsApp Number (usually a sandbox number if not approved)
# Example: whatsapp:+14155552671
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155552671

# Phone number for receiving notifications (can be overridden per request)
# Used as fallback if patient doesn't have phone in system
TWILIO_NOTIFICATION_PHONE=+51921507470
