# Normalize line endings
* text=auto

# Shell scripts must have LF
*.sh text eol=lf

# Python files
*.py text eol=lf

# JavaScript/TypeScript
*.js text eol=lf
*.ts text eol=lf

# Web
*.html text eol=lf
*.css text eol=lf
*.scss text eol=lf

# Config
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.ini text eol=lf
*.cfg text eol=lf

# Docker
Dockerfile text eol=lf
Dockerfile.* text eol=lf
.dockerignore text eol=lf

# Lock files (binary)
package-lock.json -diff
