# ============================================================
# Configuracion para Moscowle Backend (cPanel)
# NO subir este archivo a produccion.
# Usar Environment Variables desde Application Manager.
# ============================================================
FLASK_ENV=production
SECRET_KEY=cambiar_por_clave_aleatoria_larga_64_caracteres
SQLALCHEMY_DATABASE_URI=mysql+pymysql://usuario:contraseña@localhost/nombre_bd
SESSION_COOKIE_SECURE=True
GEMINI_API_KEY=tu_key_de_gemini
GROQ_API_KEY=tu_key_de_groq
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=tu-email@gmail.com
MAIL_PASSWORD=tu-app-password
MAIL_DEFAULT_SENDER=noreply@centrojuanpabloii.com
